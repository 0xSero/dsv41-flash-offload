+class _CudaAlias:
+    """__cuda_array_interface__ over a device-accessible pointer (pinned host memory under UVA)."""
+
+    def __init__(self, ptr: int, shape, typestr: str):
+        self.__cuda_array_interface__ = {"shape": tuple(shape), "typestr": typestr, "data": (int(ptr), False),
+                                         "version": 3, "strides": None}
+
+
+def _uva_alias(host: torch.Tensor) -> torch.Tensor:
+    assert host.is_pinned(), "host expert storage must be pinned"
+    typestr = {torch.int16: "<i2", torch.float16: "<f2", torch.int32: "<i4"}[host.dtype]
+    return torch.as_tensor(_CudaAlias(host.data_ptr(), host.shape, typestr), device="cuda")
+
+
+class _HostExpertTrellis:
+    """Storage for one stacked trellis param split into hot (GPU) and cold (pinned host) rows."""
+
+    def __init__(self, n_exp: int, cold_ids, row_shape, device, host_row_shape=None):
+        self.n_exp = n_exp
+        self.cold = sorted(cold_ids)
+        cold_set = set(self.cold)
+        self.hot = [e for e in range(n_exp) if e not in cold_set]
+        self.slot = {}
+        for i, e in enumerate(self.hot):
+            self.slot[e] = ("gpu", i)
+        for i, e in enumerate(self.cold):
+            self.slot[e] = ("host", i)
+        self.gpu = torch.empty((len(self.hot),) + tuple(row_shape), dtype=torch.int16, device=device)
+        # explicit device: vLLM builds models under a CUDA default device. Exact-size pageable buffer + cudaHostRegister
+        # instead of .pin_memory(): torch's caching host allocator rounds to powers of two (~2x host RAM here -> OOM).
+        self.host = torch.empty((len(self.cold),) + tuple(host_row_shape or row_shape), dtype=torch.int16, device="cpu")
+        if self.host.numel():
+            err = torch.cuda.cudart().cudaHostRegister(self.host.data_ptr(), self.host.numel() * 2, 3)  # Portable|Mapped
+            if "success" not in str(err).lower() and str(err) != "0":
+                raise RuntimeError(f"cudaHostRegister failed: {err}")
+        self.host_alias = _uva_alias(self.host) if len(self.cold) else None
+
+    def row(self, e: int) -> torch.Tensor:
+        where, i = self.slot[e]
+        return self.gpu[i] if where == "gpu" else self.host[i]
+
+    def cuda_row(self, e: int) -> torch.Tensor:
+        where, i = self.slot[e]
+        return self.gpu[i] if where == "gpu" else self.host_alias[i]
