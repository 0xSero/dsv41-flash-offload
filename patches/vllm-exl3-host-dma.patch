+# thor host-expert project (2026-09-28): EXL3_HOST_EXPERTS=<plan.json> {layer_name: [cold expert ids]}. Hot experts live in
+# a compact GPU tensor, cold experts in pinned host RAM exposed to CUDA as a zero-copy UVA alias, so every MoE path (fused
+# kernel pointer tables, LinearEXL3 forward) reads them over PCIe without kernel changes. Only the trellis (the bulk) moves;
+# suh/svh/mcg/mul1 stay stacked on the GPU.
+_EXL3_HOST_PLAN_PATH = os.environ.get("EXL3_HOST_EXPERTS", "")
+_EXL3_HOST_PLAN = None
+# EXL3_HOST_COLD_PACK=<dir of a lower-bpw EXL3 pack of the same model>: cold (host) experts are loaded from that pack instead,
+# at its bit width (e.g. hot 3 bpw from the served pack, cold 2 bpw from the 2.0 pack) -> fewer PCIe bytes per cold read.
